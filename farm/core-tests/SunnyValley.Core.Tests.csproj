<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the Unity core of «Солнечная долина» and its tests without Unity: dotnet test farm/core-tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Unity 6 compiles C# 9: keep the same language level so nothing breaks in the editor. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../unity/SunnyValley/Assets/SunnyValley/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
