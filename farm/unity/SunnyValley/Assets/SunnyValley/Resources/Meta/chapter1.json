 "scenes": [
  {
   "id": "arrival",
   "title": "Приезд",
   "lines": [
    {
     "who": "anya",
     "text": "Солнечная долина… Я не была здесь пятнадцать лет."
    },
    {
     "who": "anya",
     "text": "Бабушка Дуня оставила мне ферму. Только, похоже, ферма давно осталась одна."
    },
    {
     "who": "sharik",
     "text": "Гав! (из бурьяна выглядывает лохматая морда)"
    },
    {
     "who": "anya",
     "text": "Ой! Ты чей? На ошейнике написано: «Шарик». Бабушкин пёс! Ты меня ждал?"
    },
    {
     "who": "anya",
     "text": "Ну что, Шарик, начнём? Сначала — ворота."
    }
   ]
  },
  {
   "id": "matvey_meets",
   "title": "Сосед через забор",
   "lines": [
    {
     "who": "matvey",
     "text": "Эй, соседка! Хлам на телегу кидай — я на свалку свезу."
    },
    {
     "who": "anya",
     "text": "Спасибо! А вы…"
    },
    {
     "who": "matvey",
     "text": "Матвей. Через забор живу, сорок лет с Дуней соседствовал."
    },
    {
     "who": "matvey",
     "text": "Она про тебя всё рассказывала. Говорила: «Анютка вернётся — ферма оживёт»."
    },
    {
     "who": "anya",
     "text": "Постараюсь её не подвести."
    }
   ]
  },
  {
   "id": "first_evening",
   "title": "Первый вечер",
   "lines": [
    {
     "who": "vera",
     "text": "Ау, хозяйка! Я Вера, соседка. С пирогами!"
    },
    {
     "who": "anya",
     "text": "С капустой? Как у бабушки?"
    },
    {
     "who": "vera",
     "text": "По её рецепту! Слушай, к тебе может заглянуть один… Грачёв."
    },
    {
     "who": "vera",
     "text": "Он полдолины скупил, хочет коттеджи строить. На бабушкину землю давно глаз положил."
    },
    {
     "who": "anya",
     "text": "Пусть приходит. Я никуда не уеду."
    }
   ]
  },
  {
   "id": "diary",
   "title": "Бабушкин дневник",
   "lines": [
    {
     "who": "anya",
     "text": "Тетрадь в клетку… «Дневник фермы». Бабушкин почерк!"
    },
    {
     "who": "diary",
     "text": "Анютка, если ты это читаешь — значит, ты приехала. Я знала."
    },
    {
     "who": "diary",
     "text": "Ферма — это не дом и не поле. Это люди вокруг. Слушай Матвея, дружи с Верой, корми Шарика."
    },
    {
     "who": "diary",
     "text": "А если придёт Грачёв — не верь ни одному его слову."
    },
    {
     "who": "anya",
     "text": "Обещаю, бабушка."
    }
   ]
  },
  {
   "id": "grachev_offer",
   "title": "Чёрный джип",
   "lines": [
    {
     "who": "grachev",
     "text": "Добрый день! Грачёв, «Грачёв-Девелопмент». Какой… милый домик."
    },
    {
     "who": "grachev",
     "text": "Предлагаю хорошие деньги. Вы городская, зачем вам эти грядки?"
    },
    {
     "who": "anya",
     "text": "Затем, что это бабушкина ферма. Не продаётся."
    },
    {
     "who": "grachev",
     "text": "Посмотрим, как вы запоёте, когда пойдут дожди. Я ещё загляну."
    },
    {
     "who": "sharik",
     "text": "Рррр… (Шарик провожает чёрный джип до самой дороги)"
    }
   ]
  },
  {
   "id": "matvey_lesson",
   "title": "Урок деда Матвея",
   "lines": [
    {
     "who": "matvey",
     "text": "Ну что, хозяйка, огород поднимать будем?"
    },
    {
     "who": "anya",
     "text": "Я даже не знаю, с чего начать."
    },
    {
     "who": "matvey",
     "text": "С земли. Земля всё помнит — и лопату, и лень."
    },
    {
     "who": "matvey",
     "text": "Пшеница растёт быстро, кукуруза — подольше. А на мельнице всё в муку и в корм превратим."
