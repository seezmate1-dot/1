# Binary Unreal files go through Git LFS (TZ section 11).
AshRPG/**/*.uasset filter=lfs diff=lfs merge=lfs -text
AshRPG/**/*.umap filter=lfs diff=lfs merge=lfs -text
AshRPG/**/*.fbx filter=lfs diff=lfs merge=lfs -text
AshRPG/**/*.obj filter=lfs diff=lfs merge=lfs -text
AshRPG/**/*.png filter=lfs diff=lfs merge=lfs -text
AshRPG/**/*.tga filter=lfs diff=lfs merge=lfs -text
AshRPG/**/*.exr filter=lfs diff=lfs merge=lfs -text
AshRPG/**/*.psd filter=lfs diff=lfs merge=lfs -text
AshRPG/**/*.wav filter=lfs diff=lfs merge=lfs -text
AshRPG/**/*.ogg filter=lfs diff=lfs merge=lfs -text

# Text files keep their line endings readable on Windows
*.cpp text eol=crlf
*.h text eol=crlf
*.cs text eol=crlf
*.ini text eol=crlf
*.uproject text eol=crlf
